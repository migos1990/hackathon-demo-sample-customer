#!/usr/bin/env bash
# PS SCIM Harness — pre-commit gate.
# Operationalizes the 14 laws at commit time. Failures here are intentional
# — the failing law IS the bug, per AGENTS.md "When a Law Fails."
#
# Install once per clone: `git config core.hooksPath .githooks`
# Bypass with: `git commit --no-verify` (NOT recommended; leaves an obvious
# red flag in the audit trail for any reviewer to catch).
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

fail() { echo -e "${RED}❌ $1${NC}"; exit 1; }
pass() { echo -e "${GREEN}✓ $1${NC}"; }
warn() { echo -e "${YELLOW}⚠ $1${NC}"; }

# Resolve repo root
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ─── IRON LAW — TDD: tests must be green before commit ────────────────
# Call the binary directly to avoid npm wrapper weirdness (some environments
# route `npm` through corporate Artifactory shims that block basic commands).
if [ -x node_modules/.bin/vitest ]; then
    echo "▶ IRON LAW — running vitest"
    if ! node_modules/.bin/vitest run --silent; then
        fail "IRON LAW violation: tests not green. Fix tests first, then commit."
    fi
    pass "IRON LAW — tests green"
elif [ -f package.json ] && grep -q '"test"' package.json; then
    warn "IRON LAW — vitest not installed. Run 'npm install' then retry commit."
fi

# ─── Typecheck — TypeScript errors block the commit ──
if [ -x node_modules/.bin/tsc ] && [ -f tsconfig.json ]; then
    echo "▶ typecheck — running tsc --noEmit"
    if ! node_modules/.bin/tsc --noEmit; then
        fail "typecheck failed. Fix type errors."
    fi
    pass "typecheck clean"
elif [ -f tsconfig.json ]; then
    warn "typecheck — tsc not installed. Run 'npm install' then retry commit."
fi

# ─── Secret scan — block obvious credential patterns in staged content ──
echo "▶ secret scan — grepping staged content"
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED" ]; then
    # Allow the sanitizer's own test fixtures and the PR template to contain the
    # literal placeholder "<TOKEN>" — but flag anything that looks like a real
    # bearer value (>=20 chars, base64-ish, after "Bearer ").
    BAD=$(git diff --cached -- $STAGED | grep -E '^\+.*Bearer [A-Za-z0-9+/=_-]{20,}' || true)
    if [ -n "$BAD" ]; then
        # Exclude obvious fixture placeholders
        BAD=$(echo "$BAD" | grep -v 'Bearer <TOKEN>' | grep -v 'Bearer real-token-12345' || true)
        if [ -n "$BAD" ]; then
            echo "$BAD"
            fail "Possible real bearer token in staged content. Redact with scripts/sanitize-payload.ts and re-stage."
        fi
    fi
    # Also block .env content ever being staged
    if echo "$STAGED" | grep -qE '(^|/)\.env($|\.)'; then
        fail "Staged .env file. Secrets must never be committed — remove from stage."
    fi
fi
pass "secret scan — clean"

# ─── TRUTH LAW — behavioral claim comments near tests or UNVERIFIED ──
# Scan staged .ts files for banned comment patterns without nearby test
# or UNVERIFIED annotation. This is an advisory check — false positives
# exist; use UNVERIFIED to escape-hatch with justification.
echo "▶ TRUTH LAW — checking behavioral claim comments"
TS_STAGED=$(echo "$STAGED" | grep -E '\.ts$' | grep -v '\.test\.ts$' || true)
TRUTH_VIOLATIONS=""
for f in $TS_STAGED; do
    [ -f "$f" ] || continue
    VIOLATIONS=$(grep -nE '//.*(is|are) (idempotent|thread-safe|atomic|transactional|race-free|retry-safe)' "$f" || true)
    if [ -n "$VIOLATIONS" ]; then
        # Check for UNVERIFIED annotation in the same file
        if ! grep -q 'UNVERIFIED' "$f"; then
            # Check if there's a matching test file
            TEST_FILE="${f%.ts}.test.ts"
            if [ ! -f "$TEST_FILE" ]; then
                TRUTH_VIOLATIONS="$TRUTH_VIOLATIONS\n  $f: $VIOLATIONS"
            fi
        fi
    fi
done
if [ -n "$TRUTH_VIOLATIONS" ]; then
    warn "TRUTH LAW — behavioral claims without nearby tests or UNVERIFIED annotation:"
    echo -e "$TRUTH_VIOLATIONS"
    warn "  Add a test, or annotate with // UNVERIFIED: <why>"
    # Advisory only — don't block. Reviewer catches the rest via PR template.
fi
pass "TRUTH LAW — advisory scan done"

# ─── PLAN LAW — warn on large diffs without commit-body plan ──
ADDED=$(git diff --cached --numstat | awk '$1 != "-" {s += $1} END {print s+0}')
DELETED=$(git diff --cached --numstat | awk '$2 != "-" {s += $2} END {print s+0}')
LINES=$((ADDED + DELETED))
FILES=$(echo "$STAGED" | grep -c . || true)
if [ "$FILES" -gt 3 ] || [ "$LINES" -gt 50 ]; then
    warn "PLAN LAW — diff is $FILES files / $LINES lines. Large change; ensure your commit message cites the plan doc or includes rationale."
fi

echo -e "${GREEN}━━━ All pre-commit gates passed ━━━${NC}"
