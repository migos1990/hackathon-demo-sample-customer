# Copy this file to .env (gitignored) and fill in real values.
# Never commit .env — pre-commit hook blocks it explicitly.
# Secret-scan hook on Write operations prevents the assistant from writing
# literal secret values to disk, so this template is the handoff point.

# --- Anthropic / LiteLLM (orchestrator agent runtime) ---
ANTHROPIC_API_KEY=<paste-the-hackathon-LiteLLM-key-here>
ANTHROPIC_BASE_URL=https://llm.atko.ai/v1

# --- Linear (ticket source) ---
LINEAR_API_KEY=<paste-after-generating-at-linear.app-settings-api>

# --- GitHub (PR creation) ---
GITHUB_TOKEN=<paste-PAT-with-repo-scope>

# --- Okta demo tenants (dev → staging → prod BLAST-RADIUS) ---
OKTA_STAGING_TENANT_URL=demo-customer-a-staging.oktapreview.com
OKTA_STAGING_TOKEN=<paste-tenant-API-token>
OKTA_PROD_TENANT_URL=demo-customer-a-prod.okta.com
OKTA_PROD_TOKEN=<paste-tenant-API-token>

# --- Promotion Manifest signing (see docs/integrations/promotion-signing.md) ---
# Generate with: openssl rand -hex 32
PROMOTION_SIGNING_KEY_CURRENT=<paste-64-hex-char-key>
PROMOTION_SIGNING_KEY_CURRENT_ID=demo-current-2026q2
# Only needed during rotation windows:
# PROMOTION_SIGNING_KEY_PREVIOUS=
# PROMOTION_SIGNING_KEY_PREVIOUS_ID=

# --- AcmeHR-lite demo target (defaults are fine for local) ---
# ACME_HR_BASE_URL=http://localhost:4001
# ACME_HR_API_TOKEN=  # leave unset for dev mode

# --- Connector + smoke ---
# CONNECTOR_PORT=3002
# CONNECTOR_BUGGED_PORT=3003
# SCIM_AUTH_TOKEN=  # leave unset for dev mode
