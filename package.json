{
  "name": "scim-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Pre-built baseline for Okta SCIM connector generation (pre-hackathon harness)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sanitize": "tsx scripts/sanitize-payload.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "start:skeleton": "tsx skeleton/server.ts",
    "start:acme-hr": "tsx demo-targets/acme-hr-lite/start.ts",
    "start:acme-hr-connector": "tsx connectors/acme-hr/start.ts",
    "start:acme-hr-connector-bugged": "tsx connectors/acme-hr-bugged/start.ts",
    "smoke": "tsx scripts/smoke/cli.ts --connector-url http://localhost:3002 --target-url http://localhost:4001",
    "smoke:bugged": "tsx scripts/smoke/cli.ts --connector-url http://localhost:3003 --target-url http://localhost:4001"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "canonicalize": "^3.0.0",
    "express": "^4.19.0",
    "scim-patch": "^0.9.0",
    "scim2-parse-filter": "^0.3.0",
    "scimmy": "^1.3.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.12.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
